{
  "name": "lineage-ml",
  "version": "0.1.0",
  "private": true,
  "description": "The family tree of AI math. Every formula is computed, not drawn.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "oracle": "node scripts/py.mjs python/oracle.py",
    "verify": "npm run oracle && npm run atlas:check && vitest run",
    "atlas:check": "tsx scripts/atlas-check.ts",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run verify && npm run build",
    "mutate": "node scripts/py.mjs scripts/mutate.py",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=tokenxray"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
